{
  // Test-only view of the project: identical to tsconfig.json except that the
  // `server-only` marker resolves to a harmless stub. Kept separate so the
  // production build can never pick the stub up by accident.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"],
      "server-only": ["./test/stubs/server-only.ts"],
      // `@ee` is next.config.js's build alias; tests see the community stub,
      // the way an open-source build does (lib/compliance gates its hourly
      // sweep on featureEnabled since 1.13.0).
      "@ee": ["./src/ee-stub/index.ts"]
    }
  }
}
